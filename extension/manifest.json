{
    "manifest_version": 3,
    "name": "CCNA Answer Helper",
    "version": "3.3.1",
    "description": "CCNA exam answer lookup with auto-pass mode, manual mode, and light/dark themes",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>",
                "*://assessment.netacad.net/*"
            ],
            "js": [
                "logic/base.js",
                "logic/netacad-assessment.js",
                "logic/netacad-learning.js",
                "logic/loader.js",
                "content.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "data/*",
                "images/*",
                "logic/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}